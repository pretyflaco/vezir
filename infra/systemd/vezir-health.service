[Unit]
Description=vezir health watchdog (restart on loopback failure, alert on public-path failure)
After=vezir.service

[Service]
Type=oneshot
# Same environment as vezir.service: VEZIR_PUBLIC_URL / VEZIR_PORT drive the probes.
EnvironmentFile=-%h/.config/environment.d/vezir.conf
ExecStart=%h/.local/bin/vezir-healthcheck.sh
