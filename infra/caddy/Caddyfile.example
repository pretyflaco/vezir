# Caddyfile.example — vezir reverse proxy
#
# Purpose
# -------
# Terminate TLS in front of the local vezir uvicorn (now bound to
# 127.0.0.1:8000 by default since 0.1.12). Two listeners cover the two
# supported VPN transports:
#
#   1. Tailscale: real Let's Encrypt cert via the ts.net DNS-01 challenge.
#      Joiners trust this automatically (system trust roots).
#
#   2. nvpn:      Caddy's internal CA. Joiners must trust the root cert
#                 once. The root is published via the enrollment QR
#                 payload (Android: trusted automatically by the app's
#                 NetworkSecurityConfig; CLI: imported into the OS
#                 trust store via `vezir trust-server`).
#
# Customize: replace the two hostnames and uncomment the snippet you
# need before running `caddy run --config Caddyfile`.

# --- shared snippets ------------------------------------------------

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "no-referrer"
		# Vezir's templates are minimal and have no third-party assets,
		# so a strict CSP is safe.
		Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
		# Hide upstream identification.
		-Server
	}
}

(common_logging) {
	# Log to a dedicated file. Caddy redacts Authorization, Cookie,
	# Set-Cookie, and Proxy-Authorization headers in access logs by
	# default (they appear as "REDACTED"). No manual stripping needed.
	#
	# Do NOT add `request_header -Authorization` or similar here — that
	# would strip the header from the *upstream request*, breaking auth.
	log {
		output file /var/log/caddy/vezir-access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

(proxy_to_vezir) {
	# Reverse-proxy to the local uvicorn. Vezir trusts the X-Forwarded-*
	# headers Caddy sets by default.
	reverse_proxy 127.0.0.1:8000 {
		# Larger upload timeout (audio uploads can be hundreds of MB).
		transport http {
			read_timeout  30m
			write_timeout 30m
		}
	}
}

# --- Tailscale listener (Let's Encrypt cert via `tailscale cert`) ---
# Replace <your-host>.<tailnet>.ts.net with your tailnet's MagicDNS name.
#
# Stock Caddy cannot auto-provision certs for *.ts.net domains.
# Instead, use `tailscale cert` to get a Let's Encrypt cert/key pair
# and point Caddy at the files:
#
#   sudo tailscale cert \
#     --cert-file /etc/caddy/certs/<your-host>.<tailnet>.ts.net.crt \
#     --key-file  /etc/caddy/certs/<your-host>.<tailnet>.ts.net.key \
#     <your-host>.<tailnet>.ts.net
#
# Set up a cron/timer to renew (certs last 90 days):
#   sudo tailscale cert ... && sudo systemctl reload caddy
#
# Alternative: build Caddy with the Tailscale module for auto-renewal:
#   xcaddy build --with github.com/tailscale/caddy-tailscale

<your-host>.<tailnet>.ts.net {
	tls /etc/caddy/certs/<your-host>.<tailnet>.ts.net.crt /etc/caddy/certs/<your-host>.<tailnet>.ts.net.key
	import security_headers
	import common_logging
	import proxy_to_vezir
}

# --- nvpn listener (Caddy internal CA) -----------------------------
# Replace <NVPN_SERVER_IP> with your nvpn server IP.

<NVPN_SERVER_IP> {
	tls internal
	import security_headers
	import common_logging
	import proxy_to_vezir
}

# --- public listener (VPS front + WireGuard + nftables DNAT) --------
# This is the clearnet entry point (see infra/vps/). The flow is:
#
#   client ──HTTPS──▶ VPS:443 ──nftables DNAT──▶ 10.99.0.2:443 (this box,
#   over WireGuard) ──▶ Caddy terminates TLS ──▶ 127.0.0.1:8000
#
# TLS is TERMINATED HERE on muscle, not on the VPS: the VPS only L4-
# forwards ciphertext, so it never sees plaintext or bearer/session
# tokens (TLS passthrough). That means Caddy on THIS box must hold the
# real Let's Encrypt cert for the public hostname.
#
# Because muscle is behind double-NAT (no inbound :80/:443 from the
# internet), the HTTP-01 / TLS-ALPN-01 challenges can't work. Use the
# DNS-01 challenge via the Gandi provider plugin. Build Caddy with it:
#
#   xcaddy build --with github.com/caddy-dns/gandi
#
# and supply a Gandi Personal Access Token (PAT) with DNS edit rights on
# example.com. Store it in the environment, NOT inline:
#
#   # /etc/caddy/gandi.env  (mode 0600, owned by the caddy user)
#   GANDI_API_TOKEN=pat-xxxxxxxx
#
# and reference it via {env.GANDI_API_TOKEN} below. Systemd drop-in:
#   [Service]
#   EnvironmentFile=/etc/caddy/gandi.env

vezir.example.com {
	tls {
		dns gandi {env.GANDI_API_TOKEN}
		# Gandi LiveDNS lags ~2min before new TXT records hit the
		# authoritative NS, and public resolvers negative-cache the
		# NXDOMAIN (3h TTL). Check propagation against Gandi's OWN
		# authoritative nameservers (find them with
		# `dig +short NS <domain>` — they're ns-XX-{a,b,c}.gandi.net,
		# NOT ns-1/2/3) and give it generous time.
		resolvers ns-XX-a.gandi.net ns-XX-b.gandi.net ns-XX-c.gandi.net
		propagation_delay 120s
		propagation_timeout 600s
	}
	import security_headers
	import common_logging
	import proxy_to_vezir
}

# --- root cert download (for nvpn joiners) -------------------------
# Joiners hit this *via the QR-embedded URL* during enrollment, so they
# can trust the internal CA before their first real request. The path
# is mounted by the `caddy-trust` snippet; Caddy's admin API exposes
# the cert at /v2/pki/ca/local/certificates by default. We expose a
# friendlier copy at /trust/vezir-root.crt by routing it through.
#
# The root cert is NOT secret — distributing it is fine — but limiting
# this route to read-only GETs keeps the surface small.

# Uncomment if you want a fixed-path download URL on the same Caddy
# instance instead of running `caddy trust` manually on each joiner:
#
# <NVPN_SERVER_IP>:80 {
#     handle /trust/vezir-root.crt {
#         root * /etc/ssl/caddy-root
#         file_server
#     }
# }
